# --- Supabase (read by @nuxtjs/supabase) ---
SUPABASE_URL=
SUPABASE_KEY=            # anon/public key
# SUPABASE_SERVICE_KEY= # service-role key, server-only (for admin tasks)

# --- Public (exposed to client via runtimeConfig.public) ---
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Server-only secrets (runtimeConfig) ---
NUXT_STRIPE_SECRET_KEY=
NUXT_STRIPE_WEBHOOK_SECRET=
NUXT_ANTHROPIC_API_KEY=
NUXT_RESEND_API_KEY=
NUXT_LEAD_EMAIL=            # where "Talk to us" leads are sent
NUXT_LEAD_FROM=             # verified Resend sender, e.g. "EASY <hello@yourdomain.com>"
